# ============================================================================
# Ceremyn environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Every variable maps to src/ceremyn/config/settings.py (prefix: CEREMYN_).
# ============================================================================

# ---- Application ------------------------------------------------------------
# Trading mode: research | paper | live
# SAFETY: "live" alone does NOT enable live orders — see the live-trading gates
# below. Default is research.
CEREMYN_TRADING_MODE=research

# Environment name, affects log formatting: dev (pretty console) | prod (JSON)
CEREMYN_ENVIRONMENT=dev

# Log level: DEBUG | INFO | WARNING | ERROR
CEREMYN_LOG_LEVEL=INFO

# ---- Live trading gates -----------------------------------------------------
# ALL THREE gates must pass before a single live order can be placed:
#   1. CEREMYN_TRADING_MODE=live
#   2. CEREMYN_LIVE_TRADING_ENABLED=true
#   3. A runtime arming token submitted via the /system/arm API after startup
# Leave this false. Turn it on only after a strategy has passed paper burn-in.
CEREMYN_LIVE_TRADING_ENABLED=false

# ---- Runtime ------------------------------------------------------------------
# Strategies intentionally active in the daily runtime. Keep this small and explicit.
# JSON array format, e.g. ["long_contrarian", "long_skew"]
CEREMYN_RUNTIME__ACTIVE_STRATEGY_TYPES=["long_contrarian"]

# ---- Paper portfolio ----------------------------------------------------------
# Starting cash for the simulated/paper portfolio. Set this to your real capital.
CEREMYN_PORTFOLIO__INITIAL_CASH=1000000

# ---- PostgreSQL ---------------------------------------------------------------
CEREMYN_DB__HOST=localhost
CEREMYN_DB__PORT=5432
CEREMYN_DB__USER=ceremyn
CEREMYN_DB__PASSWORD=change-me
CEREMYN_DB__NAME=ceremyn

# ---- Redis --------------------------------------------------------------------
CEREMYN_REDIS__HOST=localhost
CEREMYN_REDIS__PORT=6379
CEREMYN_REDIS__DB=0

# ---- Zerodha Kite Connect -----------------------------------------------------
# https://developers.kite.trade/ — required for market data (all modes) and
# order placement (live mode only).
CEREMYN_KITE__API_KEY=
CEREMYN_KITE__API_SECRET=
# Daily-expiring session token. Never set this by hand — run
# `.venv/bin/python scripts/kite_login.py` each trading day; it writes this
# line for you.
CEREMYN_KITE__ACCESS_TOKEN=

# ---- Anthropic (Claude) -------------------------------------------------------
# Used ONLY for analysis: report generation, strategy review, trade explanation.
# The LLM has no code path to order placement.
CEREMYN_ANTHROPIC__API_KEY=
CEREMYN_ANTHROPIC__MODEL=claude-sonnet-5

# ---- Risk engine -------------------------------------------------------------
CEREMYN_RISK__ENABLED=true
CEREMYN_RISK__BLOCK_ON_KILL_SWITCH=true
CEREMYN_RISK__POSITION__MAX_OPEN_POSITIONS=20
CEREMYN_RISK__POSITION__MAX_POSITIONS_PER_UNDERLYING=10
CEREMYN_RISK__POSITION__MAX_LOTS_PER_SIGNAL=10
CEREMYN_RISK__MARGIN__MAX_MARGIN_USED=1000000
CEREMYN_RISK__MARGIN__MAX_MARGIN_USAGE_RATIO=0.80
CEREMYN_RISK__DRAWDOWN__MAX_DAILY_LOSS=50000
CEREMYN_RISK__DRAWDOWN__MAX_DRAWDOWN=200000
CEREMYN_RISK__GREEKS__MAX_ABS_DELTA=5000
CEREMYN_RISK__GREEKS__MAX_ABS_GAMMA=200
CEREMYN_RISK__GREEKS__MAX_ABS_VEGA=5000
CEREMYN_RISK__GREEKS__MAX_ABS_THETA=5000
CEREMYN_RISK__LIQUIDITY__MIN_LIQUIDITY_SCORE=0.25
CEREMYN_RISK__LIQUIDITY__MAX_BID_ASK_SPREAD_RATIO=0.02
CEREMYN_RISK__TIME__TRADING_START=09:15:00
CEREMYN_RISK__TIME__TRADING_END=15:30:00
CEREMYN_RISK__TIME__ALLOW_EXPIRY_DAY=false
CEREMYN_RISK__TIME__MIN_DAYS_TO_EXPIRY=1
CEREMYN_RISK__VOLATILITY__MAX_IMPLIED_VOLATILITY=0.35
CEREMYN_RISK__VOLATILITY__MAX_VOLATILITY_PERCENTILE=0.90
CEREMYN_RISK__EXPOSURE__MAX_GROSS_NOTIONAL=10000000
CEREMYN_RISK__EXPOSURE__MAX_NET_NOTIONAL_ABS=5000000
CEREMYN_RISK__EXPOSURE__MAX_UNDERLYING_CONCENTRATION_RATIO=0.60
CEREMYN_RISK__EXPOSURE__MAX_SHORT_OPTION_UNITS=5000
