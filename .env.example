# ============================================================================
# AlphaQuant environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Every variable maps to src/alphaquant/config/settings.py (prefix: ALPHAQUANT_).
# ============================================================================

# ---- Application ------------------------------------------------------------
# Trading mode: research | paper | live
# SAFETY: "live" alone does NOT enable live orders — see the live-trading gates
# below. Default is research.
ALPHAQUANT_TRADING_MODE=research

# Environment name, affects log formatting: dev (pretty console) | prod (JSON)
ALPHAQUANT_ENVIRONMENT=dev

# Log level: DEBUG | INFO | WARNING | ERROR
ALPHAQUANT_LOG_LEVEL=INFO

# ---- Live trading gates -----------------------------------------------------
# ALL THREE gates must pass before a single live order can be placed:
#   1. ALPHAQUANT_TRADING_MODE=live
#   2. ALPHAQUANT_LIVE_TRADING_ENABLED=true
#   3. A runtime arming token submitted via the /system/arm API after startup
# Leave this false. Turn it on only after a strategy has passed paper burn-in.
ALPHAQUANT_LIVE_TRADING_ENABLED=false

# ---- Paper portfolio ----------------------------------------------------------
# Starting cash for the simulated/paper portfolio. Set this to your real capital.
ALPHAQUANT_PORTFOLIO__INITIAL_CASH=1000000

# ---- PostgreSQL ---------------------------------------------------------------
ALPHAQUANT_DB__HOST=localhost
ALPHAQUANT_DB__PORT=5432
ALPHAQUANT_DB__USER=alphaquant
ALPHAQUANT_DB__PASSWORD=change-me
ALPHAQUANT_DB__NAME=alphaquant

# ---- Redis --------------------------------------------------------------------
ALPHAQUANT_REDIS__HOST=localhost
ALPHAQUANT_REDIS__PORT=6379
ALPHAQUANT_REDIS__DB=0

# ---- Zerodha Kite Connect -----------------------------------------------------
# https://developers.kite.trade/ — required for market data (all modes) and
# order placement (live mode only).
ALPHAQUANT_KITE__API_KEY=
ALPHAQUANT_KITE__API_SECRET=

# ---- Anthropic (Claude) -------------------------------------------------------
# Used ONLY for analysis: report generation, strategy review, trade explanation.
# The LLM has no code path to order placement.
ALPHAQUANT_ANTHROPIC__API_KEY=
ALPHAQUANT_ANTHROPIC__MODEL=claude-sonnet-5

# ---- Risk engine -------------------------------------------------------------
ALPHAQUANT_RISK__ENABLED=true
ALPHAQUANT_RISK__BLOCK_ON_KILL_SWITCH=true
ALPHAQUANT_RISK__POSITION__MAX_OPEN_POSITIONS=20
ALPHAQUANT_RISK__POSITION__MAX_POSITIONS_PER_UNDERLYING=10
ALPHAQUANT_RISK__POSITION__MAX_LOTS_PER_SIGNAL=10
ALPHAQUANT_RISK__MARGIN__MAX_MARGIN_USED=1000000
ALPHAQUANT_RISK__MARGIN__MAX_MARGIN_USAGE_RATIO=0.80
ALPHAQUANT_RISK__DRAWDOWN__MAX_DAILY_LOSS=50000
ALPHAQUANT_RISK__DRAWDOWN__MAX_DRAWDOWN=200000
ALPHAQUANT_RISK__GREEKS__MAX_ABS_DELTA=5000
ALPHAQUANT_RISK__GREEKS__MAX_ABS_GAMMA=200
ALPHAQUANT_RISK__GREEKS__MAX_ABS_VEGA=5000
ALPHAQUANT_RISK__GREEKS__MAX_ABS_THETA=5000
ALPHAQUANT_RISK__LIQUIDITY__MIN_LIQUIDITY_SCORE=0.25
ALPHAQUANT_RISK__LIQUIDITY__MAX_BID_ASK_SPREAD_RATIO=0.02
ALPHAQUANT_RISK__TIME__TRADING_START=09:15:00
ALPHAQUANT_RISK__TIME__TRADING_END=15:30:00
ALPHAQUANT_RISK__TIME__ALLOW_EXPIRY_DAY=false
ALPHAQUANT_RISK__TIME__MIN_DAYS_TO_EXPIRY=1
ALPHAQUANT_RISK__VOLATILITY__MAX_IMPLIED_VOLATILITY=0.35
ALPHAQUANT_RISK__VOLATILITY__MAX_VOLATILITY_PERCENTILE=0.90
ALPHAQUANT_RISK__EXPOSURE__MAX_GROSS_NOTIONAL=10000000
ALPHAQUANT_RISK__EXPOSURE__MAX_NET_NOTIONAL_ABS=5000000
ALPHAQUANT_RISK__EXPOSURE__MAX_UNDERLYING_CONCENTRATION_RATIO=0.60
ALPHAQUANT_RISK__EXPOSURE__MAX_SHORT_OPTION_UNITS=5000
