# ============================================================================
# AlphaQuant environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Every variable maps to src/alphaquant/config/settings.py (prefix: ALPHAQUANT_).
# ============================================================================

# ---- Application ------------------------------------------------------------
# Trading mode: research | paper | live
# SAFETY: "live" alone does NOT enable live orders — see the live-trading gates
# below. Default is research.
ALPHAQUANT_TRADING_MODE=research

# Environment name, affects log formatting: dev (pretty console) | prod (JSON)
ALPHAQUANT_ENVIRONMENT=dev

# Log level: DEBUG | INFO | WARNING | ERROR
ALPHAQUANT_LOG_LEVEL=INFO

# ---- Live trading gates -----------------------------------------------------
# ALL THREE gates must pass before a single live order can be placed:
#   1. ALPHAQUANT_TRADING_MODE=live
#   2. ALPHAQUANT_LIVE_TRADING_ENABLED=true
#   3. A runtime arming token submitted via the /system/arm API after startup
# Leave this false. Turn it on only after a strategy has passed paper burn-in.
ALPHAQUANT_LIVE_TRADING_ENABLED=false

# ---- PostgreSQL ---------------------------------------------------------------
ALPHAQUANT_DB__HOST=localhost
ALPHAQUANT_DB__PORT=5432
ALPHAQUANT_DB__USER=alphaquant
ALPHAQUANT_DB__PASSWORD=change-me
ALPHAQUANT_DB__NAME=alphaquant

# ---- Redis --------------------------------------------------------------------
ALPHAQUANT_REDIS__HOST=localhost
ALPHAQUANT_REDIS__PORT=6379
ALPHAQUANT_REDIS__DB=0

# ---- Zerodha Kite Connect -----------------------------------------------------
# https://developers.kite.trade/ — required for market data (all modes) and
# order placement (live mode only).
ALPHAQUANT_KITE__API_KEY=
ALPHAQUANT_KITE__API_SECRET=

# ---- Anthropic (Claude) -------------------------------------------------------
# Used ONLY for analysis: report generation, strategy review, trade explanation.
# The LLM has no code path to order placement.
ALPHAQUANT_ANTHROPIC__API_KEY=
ALPHAQUANT_ANTHROPIC__MODEL=claude-sonnet-5
